{
  "name": "flyff-wrapper",
  "version": "1.48.0",
  "description": "Electron Wrapper für Flyff Universe – Multiboxing, Automation, Gamepad",
  "main": "src/main.js",
  "author": "Evaldazz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Evaldazz/flyff-wrapper.git"
  },
  "scripts": {
    "start": "electron . --disable-gpu-sandbox",
    "start-nogpu": "electron . --disable-gpu",
    "build": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.flyff.wrapper",
    "productName": "Flyff Wrapper",
    "files": [
      "src/**/*",
      "config/**/*",
      "CHANGELOG.md",
      "eng.traineddata"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Game"
    },
    "artifactName": "FlyffWrapper.AppImage",
    "extraMetadata": {
      "main": "src/main.js"
    }
  }
}
