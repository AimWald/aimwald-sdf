{
  "name": "aimwald-sdflyff",
  "version": "1.60.0",
  "description": "Flyff Universe wrapper for Steam Deck – Multiboxing, Automation, Gamepad",
  "main": "src/main.js",
  "author": "AimWald",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AimWald/aimwald-sdflyff.git"
  },
  "scripts": {
    "start": "electron . --disable-gpu-sandbox",
    "start-nogpu": "electron . --disable-gpu",
    "build": "electron-builder --linux AppImage"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.aimwald.sdflyff",
    "productName": "AimWald SDFlyff",
    "files": [
      "src/**/*",
      "config/**/*",
      "CHANGELOG.md",
      "eng.traineddata"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "icon": "build/icon.png"
    },
    "artifactName": "SDFlyff.AppImage",
    "extraMetadata": {
      "main": "src/main.js"
    }
  }
}
